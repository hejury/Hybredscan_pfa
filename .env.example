# HybridScan backend — environment variable reference.
#
# This file documents every variable the Python backend (analyze.py,
# auth.py, backend_shared.py, api/) actually reads via os.environ. It is
# a REFERENCE only — no real values here, no secrets. The running app
# does not load .env files automatically; export these in your shell, a
# process manager, or .streamlit/secrets.toml (Streamlit-only fallback
# for VT_API_KEY / HYBRIDSCAN_ALLOWED_SCAN_DIRS / [auth]).
#
# Every variable below is optional — the app degrades safely (VirusTotal
# skipped, folder scan unavailable, etc.) when one is unset. See each
# variable's own comment for its exact fallback behavior.

# --- Detection pipeline (analyze.py) ---------------------------------

# VirusTotal API key. Absent → analyze.py falls back straight to the
# static-analysis / AI stage for every file (analyze.py::_charger_cle_vt).
VT_API_KEY=

# --- Storage location (analyze.py::_base_dir) ------------------------

# Overrides where model.pkl/model_pdf.pkl/model_docx.pkl, history.csv,
# and quarantine/ live. Absent → the directory containing analyze.py
# (the repo root itself).
HYBRIDSCAN_BASE_DIR=

# --- Folder scan security boundary (backend_shared.py) ---------------

# Semicolon-separated (Windows) / colon-separated (Linux/macOS) list of
# directories the "Scanner un dossier" feature is allowed to scan.
# Absent/empty → folder scanning is disabled entirely (fail-safe).
# Example: HYBRIDSCAN_ALLOWED_SCAN_DIRS=C:\Users\you\Desktop\HybridScan-Scan
HYBRIDSCAN_ALLOWED_SCAN_DIRS=

# --- Single configured admin account (auth.py) ------------------------

# Alternative to .streamlit/secrets.toml's [auth] section for the one
# configured administrator account. HYBRIDSCAN_AUTH_PASSWORD_HASH must
# be "<hex salt>$<sha256 hex digest>" using the same scheme as
# auth.py::_hash_password — never a plaintext password.
HYBRIDSCAN_AUTH_USERNAME=
HYBRIDSCAN_AUTH_PASSWORD_HASH=

# --- FastAPI bridge (api/config.py) -----------------------------------

# Comma-separated list of origins allowed to call the API with
# credentials (cookies). Must be explicit — never "*" (see
# api/main.py's CORSMiddleware setup). Default covers local Next.js dev.
HYBRIDSCAN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# "1" to mark the session cookie Secure (HTTPS-only) — enable this in any
# production/HTTPS deployment. Leave unset ("0") for local http:// dev,
# otherwise browsers silently drop the cookie over plain HTTP.
HYBRIDSCAN_COOKIE_SECURE=0
