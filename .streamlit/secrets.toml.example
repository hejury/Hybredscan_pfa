# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is listed in .gitignore and must never be committed.
#
# analyze.py / vt_check.py read the VirusTotal API key in this order:
#   1. the VT_API_KEY environment variable
#   2. this secrets.toml file (st.secrets["VT_API_KEY"]), when running under Streamlit
# If neither is set, VirusTotal lookups are skipped and the app falls back to
# the static-analysis (ML) stage automatically — no traceback, no crash.

VT_API_KEY = ".............."

# --- Authentification de l'application (auth.py: verify_compte_configure) ---
# Compte administrateur unique. auth.py lit cette section en premier, puis
# les variables d'environnement HYBRIDSCAN_AUTH_USERNAME /
# HYBRIDSCAN_AUTH_PASSWORD_HASH en repli. Aucune configuration -> echec ferme
# (connexion toujours refusee, jamais de session authentifiee par defaut).
#
# password_hash doit avoir la forme "<sel_hex>$<empreinte_sha256_hex>",
# produite par le meme algorithme que auth.py:_hash_password(). Ne jamais
# stocker un mot de passe en clair ici. Pour generer une valeur locale :
#
#   python3 -c "import secrets; from auth import _hash_password; \
#     s=secrets.token_hex(16); p=input('mot de passe : '); \
#     print(s + '$' + _hash_password(p, s))"
[auth]
username = "change-me"
password_hash = "replace-with-a-secure-hash"
